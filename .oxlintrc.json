{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  "ignorePatterns": [
    "assets/**",
    "components/**",
    "modules/**",
    "docs/**",
    "node_modules/**"
  ],

  "categories": {
    "correctness": "warn"
  },

  "rules": {
    "complexity": ["error", 10],
    "max-depth": ["error", 4],
    "no-redeclare": "error"
  }
}
